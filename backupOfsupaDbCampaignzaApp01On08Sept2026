CREATE FUNCTION public.get_dashboard_highlights() RETURNS json
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
    v_user_id uuid;
    v_role_name text;
    v_influencer_id uuid;
    v_agency_id uuid;
    v_result json;
BEGIN
    -- 1. Identify the authenticated user session
    v_user_id := auth.uid();
    IF v_user_id IS NULL THEN
        RETURN json_build_object('error', 'Unauthenticated');
    END IF;

    -- 2. Fetch the user's CURRENT active role name
    SELECT LOWER(r.role_name) INTO v_role_name
    FROM public.users u
    JOIN public.rbac_roles r ON u.role_id = r.role_id
    WHERE u.user_id = v_user_id;

    -- =========================================================================
    -- CASE 1: INFLUENCER ROLE
    -- =========================================================================
    IF v_role_name = 'influencer' THEN
        SELECT influencer_id INTO v_influencer_id 
        FROM public.user_influencer_link 
        WHERE user_id = v_user_id 
        LIMIT 1;

        IF v_influencer_id IS NULL THEN
            RETURN json_build_object(
                'role', 'influencer',
                'total_collaborations', 0,
                'active_links', 0,
                'message', 'Influencer profile setup pending'
            );
        END IF;

        SELECT json_build_object(
            'role', 'influencer',
            'total_collaborations', (SELECT COUNT(*) FROM public.collaborations WHERE influencer_id = v_influencer_id),
            'active_links', (
                SELECT COUNT(*) 
                FROM public.referrer_links rl
                JOIN public.collaborations col ON rl.collaboration_id = col.collaboration_id
                WHERE col.influencer_id = v_influencer_id
            )
        ) INTO v_result;

    -- =========================================================================
    -- CASE 2: AGENCY_MANAGER ROLE (FIXED: Added linked brands count)
    -- =========================================================================
    ELSIF v_role_name = 'agency_manager' THEN
        SELECT agency_id INTO v_agency_id 
        FROM public.user_agency_link 
        WHERE user_id = v_user_id 
        LIMIT 1;

        IF v_agency_id IS NULL THEN
            RETURN json_build_object('role', 'agency_manager', 'error', 'No agency link found');
        END IF;

        SELECT json_build_object(
            'role', 'agency_manager',
            'active_campaigns', (SELECT COUNT(*) FROM public.campaign WHERE campaign_agency_id = v_agency_id),
            'total_collaborations', (SELECT COUNT(*) FROM public.collaborations col JOIN public.campaign c ON col.campaign_id = c.campaign_id WHERE c.campaign_agency_id = v_agency_id),
            -- Looks up brands assigned exclusively to this manager's corporate agency
            'total_brands', (SELECT COUNT(*) FROM public.agency_brand_links WHERE agency_id = v_agency_id)
        ) INTO v_result;

    -- =========================================================================
    -- CASE 3: ADMIN ROLE (FIXED: Added global brands count)
    -- =========================================================================
    ELSIF v_role_name = 'admin' THEN
        SELECT json_build_object(
            'role', 'admin',
            'total_agencies', (SELECT COUNT(*) FROM public.agencies),
            'total_campaigns', (SELECT COUNT(*) FROM public.campaign),
            'total_influencers', (SELECT COUNT(*) FROM public.influencer),
            -- Returns total system brands across all ecosystems globally
            'total_brands', (SELECT COUNT(*) FROM public.brands)
        ) INTO v_result;

    ELSE
        SELECT json_build_object('role', 'unknown', 'message', 'Role metrics not implemented') INTO v_result;
    END IF;

    RETURN v_result;
END;
$$;


