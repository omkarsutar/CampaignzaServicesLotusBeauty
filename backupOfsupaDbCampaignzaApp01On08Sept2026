CREATE FUNCTION public.handle_full_row_audit() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
    current_session_user uuid := auth.uid();
    current_database_time timestamptz := CLOCK_TIMESTAMP();
BEGIN
    IF (TG_OP = 'INSERT') THEN
        NEW.created_by := COALESCE(NEW.created_by, current_session_user);
        NEW.updated_by := COALESCE(NEW.updated_by, current_session_user);
        NEW.created_at := COALESCE(NEW.created_at, current_database_time);
        NEW.updated_at := COALESCE(NEW.updated_at, current_database_time);
    ELSIF (TG_OP = 'UPDATE') THEN
        NEW.created_by := OLD.created_by;
        NEW.created_at := OLD.created_at;
        NEW.updated_by := COALESCE(current_session_user, OLD.updated_by);
        NEW.updated_at := current_database_time;
    END IF;
    RETURN NEW;
END;
$$;


