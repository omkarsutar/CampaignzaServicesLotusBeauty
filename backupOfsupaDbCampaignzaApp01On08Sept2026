CREATE FUNCTION public.decode_url(p_text text) RETURNS text
    LANGUAGE plpgsql IMMUTABLE PARALLEL SAFE
    AS $$
DECLARE
    v_text text := p_text;
    v_hex text;
    v_char text;
BEGIN
    IF v_text IS NULL THEN
        RETURN '';
    END IF;

    -- 1. Escape literal percentage signs first to prevent recursion loops
    v_text := replace(v_text, '%25', chr(37));

    -- 2. Extract and convert all standard %XX hex pairs dynamically
    FOR v_hex IN 
        SELECT DISTINCT substring(m[1] from 2 for 2)
        FROM regexp_matches(v_text, '(%[0-9a-fA-F]{2})', 'g') AS m
    LOOP
        BEGIN
            -- FIX: Safely parse standard hex string variants via native conversion engine
            v_char := convert_from(decode(v_hex, 'hex'), 'UTF-8');
            
            -- Replace both uppercase and lowercase variations in the URL string
            v_text := replace(v_text, '%' || upper(v_hex), v_char);
            v_text := replace(v_text, '%' || lower(v_hex), v_char);
        EXCEPTION WHEN others THEN
            -- Safe fallback: Skip malformed byte structures without crashing
            CONTINUE;
        END;
    END LOOP;

    RETURN v_text;
END;
$$;


