    -- Normalize incoming payload parameters
    v_referrer_raw := public.decode_url(p_referrer_raw);
    
    -- Extract standard UTM parameters
    v_source := substring(v_referrer_raw from 'utm_source=([^&]+)');
    v_medium := substring(v_referrer_raw from 'utm_medium=([^&]+)');
    v_campaign := substring(v_referrer_raw from 'utm_campaign=([^&]+)');
    v_domain := substring(v_referrer_raw from '^[a-zA-Z][a-zA-Z0-9+.-]*://([^/?#]+)');

    -- Extract standard web path first
    v_path := substring(v_referrer_raw from '^[a-zA-Z][a-zA-Z0-9+.-]*://[^/]+([^?#]*)');

    -- FIX: If a hash router framework path is found, isolate the route inside the hash block
    IF v_referrer_raw LIKE '%#/%' THEN
        v_path := substring(v_referrer_raw from '#([^?]+)');
    END IF;

    -- Normalize trailing slashes for an exact match comparison
    v_path := rtrim(v_path, '/');

    RETURN (
        SELECT count(*)::integer
        FROM public.website_visit_tracking w
        WHERE lower(w.domain_name) = lower(COALESCE(v_domain, w.domain_name))
          AND w.utm_source = COALESCE(v_source, w.utm_source)
          AND w.utm_medium = COALESCE(v_medium, w.utm_medium)
          AND w.utm_campaign = COALESCE(v_campaign, w.utm_campaign)
          -- Normalizes both database records and payload routes for precise path isolation
          AND lower(rtrim(
              CASE 
                  WHEN public.decode_url(w.referrer_raw) LIKE '%#/%' 
                  THEN substring(public.decode_url(w.referrer_raw) from '#([^?]+)')
                  ELSE substring(public.decode_url(w.referrer_raw) from '^[a-zA-Z][a-zA-Z0-9+.-]*://[^/]+([^?#]*)')
              END, 
          '/')) = lower(v_path)
    );
END;
$$;


