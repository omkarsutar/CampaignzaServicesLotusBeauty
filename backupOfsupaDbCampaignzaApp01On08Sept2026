    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
DECLARE
    v_brand record;
    v_unused_gmb_texts text[];
    v_result json;
BEGIN
    -- 1. Locate active brand by ID, brand_name, or fallback to the first active brand
    IF p_brand_id IS NOT NULL THEN
        SELECT * INTO v_brand
        FROM public.brand_data
        WHERE id = p_brand_id AND is_active = true
        LIMIT 1;
    ELSIF p_brand_name IS NOT NULL THEN
        SELECT * INTO v_brand
        FROM public.brand_data
        WHERE LOWER(brand_name) = LOWER(p_brand_name) AND is_active = true
        LIMIT 1;
    ELSE
        SELECT * INTO v_brand
        FROM public.brand_data
        WHERE is_active = true
        ORDER BY created_at ASC
        LIMIT 1;
    END IF;

    -- Return NULL if no matching brand was found
    IF v_brand IS NULL THEN
        RETURN NULL;
    END IF;

    -- 2. Fetch up to 3 unused review texts (is_used = false) from gmb_review_texts table
    SELECT COALESCE(ARRAY_AGG(gmb_review_text), ARRAY[]::text[]) INTO v_unused_gmb_texts
    FROM (
        SELECT gmb_review_text
        FROM public.gmb_review_texts
        WHERE brand_data_id = v_brand.id
          AND is_used = false
          AND is_active = true
        ORDER BY created_at ASC
        LIMIT 3
    ) sub;

    -- 3. Construct JSON response (gmb_review_texts array limited to max 3 items)
    SELECT json_build_object(
        'id', v_brand.id,
        'brand_name', v_brand.brand_name,
        'brand_photo_url', v_brand.brand_photo_url,
        'website_url', v_brand.website_url,
        'android_app_id', v_brand.android_app_id,
        'meta_pixel_id', v_brand.meta_pixel_id,
        'gmb_profile_url', v_brand.gmb_profile_url,
        'gmb_review_ques', COALESCE(v_brand.gmb_review_ques, ARRAY[]::text[]),
        'gmb_review_ques_hi', COALESCE(v_brand.gmb_review_ques_hi, ARRAY[]::text[]),
        'gmb_review_ques_mr', COALESCE(v_brand.gmb_review_ques_mr, ARRAY[]::text[]),
        'gmb_review_texts', v_unused_gmb_texts,
        'whatsapp_no', v_brand.whatsapp_no,
        'whatsapp_msg_text', v_brand.whatsapp_msg_text,
        'youtube_url', v_brand.youtube_url,
        'instagram_url', v_brand.instagram_url,
        'facebook_url', v_brand.facebook_url,
        'is_active', v_brand.is_active
    ) INTO v_result;

    RETURN v_result;
END;
$$;


