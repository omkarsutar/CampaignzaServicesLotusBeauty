            json_agg(
                json_build_object(
                    'campaign_id', c.campaign_id,
                    'campaign_name', c.campaign_name,
                    'campaign_type', c.campaign_type,
                    'campaign_platform', c.campaign_platform,
                    'total_clicks', c.computed_clicks,
                    'total_installs', c.computed_installs,
                    'referrer_links', c.links_array
                )
            ), '[]'::json
        )
    ) INTO v_result
    FROM (
        SELECT
            cam.campaign_id,
            cam.campaign_name,
            cam.campaign_type,
            cam.campaign_platform,
            COALESCE(SUM(metrics.click_count), 0)::INT AS computed_clicks,
            COALESCE(SUM(metrics.install_count), 0)::INT AS computed_installs,
            COALESCE(json_agg(metrics.link_details ORDER BY metrics.referrer_link_string), '[]'::json) AS links_array
        FROM public.campaign cam
        LEFT JOIN LATERAL (
            SELECT
                rl.referrer_link_id,
                rl.referrer_link_string,
                rl.referrer_link_type,
                rl.referrer_link_source,
                
                -- WEBSITES: Match campaign criteria and validate isolated subdirectory paths
                CASE
                    WHEN cam.campaign_platform IN ('website', 'web_app') THEN (
                        SELECT COUNT(*)::INT
                        FROM public.website_visit_tracking w
                        WHERE w.visit_timestamp >= p_start_date
                          AND w.visit_timestamp <= p_end_date
                          AND w.utm_source = COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_source=([^&]+)'), w.utm_source)
                          AND w.utm_medium = COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_medium=([^&]+)'), w.utm_medium)
                          AND LOWER(w.utm_campaign) = LOWER(COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_campaign=([^&]+)'), w.utm_campaign))
                          -- FIX: Cleanly extract the explicit path subdirectories, standardising empty variants to "/"
                          AND COALESCE(NULLIF(rtrim(substring(public.decode_url(rl.referrer_link_string) from '^https?://[^/]+([^?]*)'), '/'), ''), '/') = 
                              COALESCE(NULLIF(rtrim(substring(w.referrer_raw from '^https?://[^/]+([^?]*)'), '/'), ''), '/')
                    )
                    ELSE 0
                END AS click_count,
                
                -- APPS: Standard indexed date parameters filter tracking updates
                CASE
                    WHEN cam.campaign_platform IN ('android_app', 'ios_app') THEN (
                        SELECT COUNT(*)::INT
                        FROM public.app_install_tracking a
                        WHERE a.created_at >= p_start_date
                          AND a.created_at <= p_end_date
                          AND a.utm_source = COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_source=([^&]+)'), a.utm_source)
                          AND a.utm_medium = COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_medium=([^&]+)'), a.utm_medium)
                          AND LOWER(a.utm_campaign) = LOWER(COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_campaign=([^&]+)'), a.utm_campaign))
                    )
                    ELSE 0
                END AS install_count,
                
                -- Construct the JSON child objects safely
                json_build_object(
                    'link_id', rl.referrer_link_id,
                    'link_string', rl.referrer_link_string,
                    'link_type', rl.referrer_link_type,
                    'link_source', rl.referrer_link_source,
                    'clicks', CASE WHEN cam.campaign_platform IN ('website', 'web_app') THEN (
                        SELECT COUNT(*)::INT 
                        FROM public.website_visit_tracking w
                        WHERE w.visit_timestamp >= p_start_date 
                          AND w.visit_timestamp <= p_end_date
                          AND w.utm_source = COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_source=([^&]+)'), w.utm_source)
                          AND w.utm_medium = COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_medium=([^&]+)'), w.utm_medium)
                          AND LOWER(w.utm_campaign) = LOWER(COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_campaign=([^&]+)'), w.utm_campaign))
                          -- Same path matching logic applied to child nodes
                          AND COALESCE(NULLIF(rtrim(substring(public.decode_url(rl.referrer_link_string) from '^https?://[^/]+([^?]*)'), '/'), ''), '/') = 
                              COALESCE(NULLIF(rtrim(substring(w.referrer_raw from '^https?://[^/]+([^?]*)'), '/'), ''), '/')
                    ) ELSE 0 END,
                    'installs', CASE WHEN cam.campaign_platform IN ('android_app', 'ios_app') THEN (
                        SELECT COUNT(*)::INT 
                        FROM public.app_install_tracking a
                        WHERE a.created_at >= p_start_date 
                          AND a.created_at <= p_end_date
                          AND a.utm_source = COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_source=([^&]+)'), a.utm_source)
                          AND a.utm_medium = COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_medium=([^&]+)'), a.utm_medium)
                          AND LOWER(a.utm_campaign) = LOWER(COALESCE(substring(public.decode_url(rl.referrer_link_string) from 'utm_campaign=([^&]+)'), a.utm_campaign))
                    ) ELSE 0 END
                ) AS link_details
            FROM public.referrer_links rl
            WHERE rl.campaign_id = cam.campaign_id
               OR rl.collaboration_id IN (
                    SELECT col.collaboration_id
                    FROM public.collaborations col
                    WHERE col.campaign_id = cam.campaign_id
               )
        ) metrics ON TRUE
        WHERE cam.campaign_brand_id = p_brand_id
          AND cam.is_active = true
        GROUP BY cam.campaign_id, cam.campaign_name, cam.campaign_type, cam.campaign_platform
    ) c;

    RETURN v_result;
END;
$$;


