--

CREATE FUNCTION public.handle_new_auth_user() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
declare
  guest_role_id uuid;
  guest_agency_id uuid;
begin
  -- Get the guest role ID
  select role_id into guest_role_id
  from public.rbac_roles
  where role_name = 'guest'
  limit 1;

  -- Get the guest agency ID
  select agency_id into guest_agency_id
  from public.agencies
  where agency_name = 'Guest agency'
  limit 1;

  begin
    insert into public.users (
      user_id, 
      full_name, 
      role_id, 
      created_at, 
      updated_at
    )
    values (
      new.id,
      coalesce(new.raw_user_meta_data->>'full_name', new.email),
      guest_role_id,
      now(),
      now()
    );

    -- Also link the new user to the guest agency in user_agency_link
    -- instead of using a column on the users table
    if guest_agency_id is not null then
      insert into public.user_agency_link (user_id, agency_id)
      values (new.id, guest_agency_id)
      on conflict do nothing;
    end if;

  exception when others then
    raise notice 'Insert into public.users failed: %', sqlerrm;
    -- Do not abort the transaction, just skip
  end;

  return new;
end;
$$;


