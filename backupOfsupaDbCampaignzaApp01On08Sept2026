CREATE FUNCTION public.resequence_visit_order_after_delete() RETURNS trigger
    LANGUAGE plpgsql
    AS $$BEGIN
  -- Resequence all items in the same agency that come after the deleted item
  UPDATE agency_brand_links rsl
  SET visit_order = rsl.visit_order - 1
  WHERE rsl.agency_id = OLD.agency_id
    AND rsl.visit_order > OLD.visit_order;
  
  RETURN OLD;
END;$$;


